# Copy this template to .env.local and edit it privately. Never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
DATABASE_PATH=.data/translogix.sqlite
# Optional locally. Required on Vercel: connect Neon and use its pooled URL.
DATABASE_URL=

# Local development seeds three example accounts on the FIRST database start.
# The built server (pnpm start) seeds demo accounts only when explicitly true.
SEED_DEMO_DATA=true
DEMO_PASSWORD=

# For a new database without demo accounts, set SEED_DEMO_DATA=false and both:
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Enable for an HTTPS production origin. Leave false for local HTTP development.
COOKIE_SECURE=false
